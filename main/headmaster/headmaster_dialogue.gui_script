	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	print("GUI MSG", message_id)
	if message_id == hash("show_dialogue") then
		gui.set_text(gui.get_node("dialogue_text"), message.text)
		gui.set_enabled(gui.get_node("dialogue_box"), true)
		gui.set_enabled(gui.get_node("dialogue_text"), true)
	elseif message_id == hash("hide_dialogue") then
		gui.set_enabled(gui.get_node("dialogue_box"), false)
		gui.set_enabled(gui.get_node("dialogue_text"), false)
	end
end

