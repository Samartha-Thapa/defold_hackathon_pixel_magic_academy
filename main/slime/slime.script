function init(self)
	self.hp = 3
	self.speed = 60
	self.chase_range = 220
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	local player_pos = go.get_position("/player")
	local my_pos = go.get_position()
	local to_player = player_pos - my_pos
	local dist = vmath.length(to_player)
	-- Only chase if player is close, so slimes stay and guard the road
	if dist < self.chase_range and dist > 1 then
		to_player = vmath.normalize(to_player)
		my_pos = my_pos + to_player * self.speed * dt
		go.set_position(my_pos)
		-- Face the player
		if to_player.x < 0 then
			sprite.set_hflip("#sprite", true)
		else
			sprite.set_hflip("#sprite", false)
		end
	end
end

function late_update(self, dt)
	-- This function is called at the end of update cycle but before render
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("hit") then
		self.hp = self.hp - message.damage
		print("SLIME HIT, HP:", self.hp)
		if self.hp <= 0 then
			go.delete()
		end
	elseif message_id == hash("contact_point_response") then
		-- Push out of walls, player, and other slimes, so it stays solid
		if message.group == hash("world") or message.group == hash("player") or message.group == hash("slime") then
			local pos = go.get_position()
			pos = pos + message.normal * message.distance
			go.set_position(pos)
		end
	end
end

