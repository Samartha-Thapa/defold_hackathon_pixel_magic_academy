function on_message(self, message_id, message, sender)
	if message_id == hash("update_hud") then
		local mana = message.mana or 100
		local books = message.books or 0
		-- Mana bar shrinks as mana drops, 200 is full width
		local fill = gui.get_node("mana_fill")
		gui.set_size(fill, vmath.vector3(200 * mana / 100, 20, 0))
		gui.set_text(gui.get_node("mana_text"), "Mana " .. math.floor(mana))
		gui.set_text(gui.get_node("books_text"), "Books " .. books .. "/3")
	end
end

