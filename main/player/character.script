-- Define movement speed (pixels per second)
local SPEED = 180


function init(self)
	self.facing = vmath.vector3(1, 0, 0)
	self.mana = 100
	self.cooldown = 0
	-- Quest stuff, this was missing before
	self.books = 0
	self.quest = "none" -- none, started, done
	self.showing_dialogue = false
	self.dialogue_timer = 0
	-- Tell Defold this game object wants to receive input events
	msg.post(".", "acquire_input_focus")
	-- Tell the engine to use our attached camera component
	msg.post("#camera", "acquire_camera_focus")
	-- Keep track of movement direction
	self.dir = vmath.vector3()
	-- Keep track of the current playing animation to prevent restarting it every frame
	self.current_anim = nil
	-- Keep track of what NPC we are currently touching
	self.near_npc = nil
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	self.cooldown = self.cooldown - dt
	if self.mana < 100 then self.mana = self.mana + 10 * dt end
	msg.post("/hud#hud", "update_hud", { mana = self.mana, books = self.books })
	-- Auto hide pickup message after 2 seconds
	if self.showing_dialogue and self.dialogue_timer > 0 then
		self.dialogue_timer = self.dialogue_timer - dt
		if self.dialogue_timer <= 0 then
			msg.post("/ui#dialogue", "hide_dialogue")
			self.showing_dialogue = false
		end
	end
	local anim = hash("idle")
	if vmath.length_sqr(self.dir) > 0 then
		self.dir = vmath.normalize(self.dir)
		self.facing = vmath.vector3(self.dir)
		if self.dir.y > 0 then anim = hash("up")
		elseif self.dir.y < 0 then anim = hash("down")
		elseif self.dir.x < 0 then anim = hash("left")
		elseif self.dir.x > 0 then anim = hash("right")
		end
		local pos = go.get_position()
		pos = pos + self.dir * SPEED * dt
		go.set_position(pos)
		self.dir = vmath.vector3()
	end
	if anim ~= self.current_anim then
		self.current_anim = anim
		sprite.play_flipbook("#sprite", anim)
	end
end

