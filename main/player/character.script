	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	if message_id == hash("contact_point_response") and (message.group == hash("world") or message.group == hash("slime")) then
		local new_pos = go.get_position()
		new_pos = new_pos + message.normal * message.distance
		go.set_position(new_pos)
	elseif message_id == hash("trigger_response") then
		print("TRIGGER", message.enter, message.group, sender)
		if message.group == hash("npc") then
			if message.enter then
				self.near_npc = "headmaster"
			else
				self.near_npc = nil
				msg.post("/ui#dialogue", "hide_dialogue")
				self.showing_dialogue = false
			end
		elseif message.group == hash("book") and message.enter then
			if self.quest == "started" then
				self.books = self.books + 1
				go.delete(message.other_id)
				msg.post("/ui#dialogue", "show_dialogue", { text = "You found a spellbook! " .. self.books .. "/3" })
				self.showing_dialogue = true
				self.dialogue_timer = 2
			else
				msg.post("/ui#dialogue", "show_dialogue", { text = "A spellbook! Talk to the Headmaster first to start your quest." })
				self.showing_dialogue = true
				self.dialogue_timer = 2
			end
		end
	end
end

function on_input(self, action_id, action)
	-- Movement Keys
	if action_id == hash("up") then self.dir.y = 1
	elseif action_id == hash("down") then self.dir.y = -1
	elseif action_id == hash("left") then self.dir.x = -1
	elseif action_id == hash("right") then self.dir.x = 1
		-- PRESS INTERACT KEY (E)
	elseif action_id == hash("interact") and action.pressed then
		if self.near_npc == "headmaster" then
			if self.showing_dialogue then
				msg.post("/ui#dialogue", "hide_dialogue")
				self.showing_dialogue = false
			else
				local text = ""
				if self.quest == "none" then
					self.quest = "started"
					text = "Welcome! 3 spellbooks were stolen. Find them and bring them back! Press SPACE to cast fireball."
				elseif self.quest == "started" and self.books < 3 then
					text = "You have " .. self.books .. "/3 spellbooks. Keep searching the courtyard!"
				elseif self.quest == "started" and self.books >= 3 then
					self.quest = "done"
					-- text = "You did it! You saved Pixel Academy! YOU WIN!"
					msg.post("/win#win", "show_win")
				elseif self.quest == "done" then
					text = "You are a true wizard now!"
				end
				msg.post("/ui#dialogue", "show_dialogue", { text = text })
				self.showing_dialogue = true
			end
		end
	elseif action_id == hash("cast") and action.pressed then
		if self.mana >= 20 and self.cooldown <= 0 then
			self.mana = self.mana - 20
			self.cooldown = 0.4
			local pos = go.get_position()
			factory.create("#fireball_factory", pos, nil, { dir = self.facing })
		end
	end
end

