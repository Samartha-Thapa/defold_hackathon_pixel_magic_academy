-- Define movement speed (pixels per second)
local SPEED = 180


function init(self)
	-- Tell Defold this game object wants to receive input events
	msg.post(".", "acquire_input_focus")

	-- Tell the engine to use our attached camera component
	msg.post("#camera", "acquire_camera_focus")

	-- Keep track of movement direction
	self.dir = vmath.vector3()
	-- Keep track of the current playing animation to prevent restarting it every frame
	self.current_anim = nil
end

function final(self)
	-- Add finalization code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function update(self, dt)
	-- Determine animation state based on movement direction
	local anim = hash("idle") -- Default to idle
	
	-- If the player is moving, calculate new position
	if vmath.length_sqr(self.dir) > 0 then
		-- Normalize vector so diagonal movement isn't faster
		self.dir = vmath.normalize(self.dir)
		
		-- Choose movement animation based on direction vectors
		if self.dir.y > 0 then
			anim = hash("up")
		elseif self.dir.y < 0 then
			anim = hash("down")
		elseif self.dir.x < 0 then
			anim = hash("left")
		elseif self.dir.x > 0 then
			anim = hash("right")
		end
		
		-- Get current position and add the movement step
		local pos = go.get_position()
		pos = pos + self.dir * SPEED * dts
		go.set_position(pos)

		-- Reset direction vector for the next frame
		self.dir = vmath.vector3()
	end

	-- Only change the animation loop if it's different from what's currently playing
	if anim ~= self.current_anim then
		self.current_anim = anim
		-- "#sprite" targets the sprite component on your game object
		sprite.play_flipbook("#sprite", anim)
	end
	
end

function late_update(self, dt)
	-- Get current position of the game object:
	local current_position = go.get_position()

	-- Add to it a direction vector multiplied by speed and delta time:
	local new_position = current_position + self.dir * 150 * dt

	-- Set the new position to the game object:
	go.set_position(new_position)

	-- Reset the direction 
	self.direction = vmath.vector3()
end

function fixed_update(self, dt)
	-- This function is called if 'Fixed Update Frequency' is enabled in the Engine section of game.project
	-- Can be coupled with fixed updates of the physics simulation if 'Use Fixed Timestep' is enabled in
	-- Physics section of game.project
	-- Add update code here
	-- Learn more: https://defold.com/manuals/script/
	-- Remove this function if not needed
end

function on_message(self, message_id, message, sender)
	-- Check if we hit a solid object
	if message_id == hash("contact_point_response") then
		-- Only care if we hit something in the "world" group
		if message.group == hash("world") then
			-- Get the current position
			local new_pos = go.get_position()
			-- Separate the player out of the wall using the correction vector provided by Defold
			new_pos = new_pos + message.normal * message.distance
			-- Apply the corrected position instantly
			go.set_position(new_pos)
		end
	end
end

function on_input(self, action_id, action)
	-- Change the direction vector based on current inputs:
	if action_id == hash("up") then
		self.dir.y = 1
	elseif action_id == hash("down") then
		self.dir.y = -1
	elseif action_id == hash("left") then
		self.dir.x = -1
	elseif action_id == hash("right") then
		self.dir.x = 1
	end
end

function on_reload(self)
	-- Add reload-handling code here
	-- Learn more: https://defold.com/manuals/hot-reload/
	-- Remove this function if not needed
end
